echo "binary gir (0 veya 1)"
read binary1

if [ "$binary1" = "0" ] || [ "$binary1" = "1" ]; then
    echo "bir daha binary gir (0 veya 1)"
    read binary2

    if [ "$binary2" = "0" ] || [ "$binary2" = "1" ]; then
        echo "seçim gir: AND / OR / NOT"
        read secim

        if [ "$secim" = "AND" ]; then
            if [ "$binary1" = "1" ] && [ "$binary2" = "1" ]; then
                echo "1"
            else
                echo "0"
            fi

        elif [ "$secim" = "OR" ]; then
            if [ "$binary1" = "1" ] || [ "$binary2" = "1" ]; then
                echo "1"
            else
                echo "0"
            fi
        elif [ "$secim" = "NOT" ]; then
            if [ "$binary1" = "0" ] && [ "$binary2" = "0" ]; then
                echo "1"
            else
                echo "0"
            fi
        else
            echo "geçersiz seçim"
        fi
    else
        echo "hata"
    fi
else
    echo "hata"
fi

