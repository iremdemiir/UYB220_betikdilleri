echo "ilk sayıyı giriniz:"
read sayi1
echo "ikinci sayıyı giriniz:"
read sayi2 
echo  "işlemi seçin"
echo " toplama"
echo " çıkarma" 
echo " bölme"  
echo " çarpma"
read secim

if [ "$secim" = "toplama" ]; then
    toplam=$((sayi1 + sayi2))
    echo "toplam = $toplam"

elif [ "$secim" = "çıkarma" ]; then
    cikarma=$((sayi1 - sayi2))
    echo "çıkarma = $cikarma"

elif [ "$secim" = "çarpma" ]; then
    carpma=$((sayi1 * sayi2))
    echo "çarpım = $carpma"

elif [ "$secim" = "bölme" ]; then
    bolme=$((sayi1 / sayi2))
    echo "bölüm = $bolme"

else
    echo "geçersiz seçim"
fi
